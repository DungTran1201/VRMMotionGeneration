# Experiment directory local gitignore

# Model checkpoints and weights
checkpoints/*
!checkpoints/README.md
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
*.bin

# Datasets and raw data dumps
datasets/*
!datasets/README.md
*.h5
*.hdf5
*.npy
*.npz
*.parquet
*.tar
*.tar.gz
*.zip

# Generated run artifacts and metrics
artifacts/*
!artifacts/README.md
*.pkl
*.tensor

# Python virtual environments & caches
.venv/
env/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
