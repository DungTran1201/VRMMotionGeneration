sequenceDiagram
    autonumber
    actor Client as Frontend Client
    participant WS as WebSocket Endpoint (/api/generations/{id}/events)
    participant JM as Job Manager
    participant Worker as Background Task

    Client->>WS: WebSocket Handshake & Connect
    WS->>JM: Subscribe(job_id, queue)
    JM-->>WS: Return current job state
    WS-->>Client: Send initial JSON {"status": "queued"}

    Worker->>JM: Dispatch update {"status": "processing", "progress_step": "encoding_prompt"}
    JM->>WS: Push update to subscriber queue
    WS-->>Client: Message {"status": "processing", "progress_step": "encoding_prompt"}

    Worker->>JM: Dispatch update {"status": "processing", "progress_step": "diffusion_denoiser"}
    JM->>WS: Push update to subscriber queue
    WS-->>Client: Message {"status": "processing", "progress_step": "diffusion_denoiser"}

    Worker->>JM: Dispatch update {"status": "processing", "progress_step": "decoding_tokenizer"}
    JM->>WS: Push update to subscriber queue
    WS-->>Client: Message {"status": "processing", "progress_step": "decoding_tokenizer"}

    Worker->>JM: Dispatch update {"status": "completed", "result": {...}}
    JM->>WS: Push completion event
    WS-->>Client: Message {"status": "completed", "result": {...}}

    WS->>JM: Unsubscribe(job_id, queue)
    WS-->>Client: Close WebSocket Frame
