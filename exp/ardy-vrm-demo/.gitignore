# exp/ardy-vrm-demo local gitignore

# Virtual environments
.venv/
env/
venv/

# Large checkpoints and weights
checkpoints/*
!checkpoints/README.md
*.safetensors
*.ckpt
*.pt
*.bin
*.onnx

# Vendor submodule/clone (upstream code)
vendor/*
!vendor/README.md

# Node build and dependencies
node_modules/
dist/
.vite/

# Python test, cache & byte-code
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Local database and run logs
*.log
*.sqlite
*.db

# Generated raw large runs (keep sample-motion tracked)
artifacts/benchmark/*.json
artifacts/benchmark/*.csv
