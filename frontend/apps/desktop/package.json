{
  "name": "@vrm/desktop",
  "version": "0.1.0",
  "description": "Native Electron desktop application shell with hardened security",
  "main": "./dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron .",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:renderer",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && vue-tsc --noEmit",
    "test": "vitest run",
    "package": "electron-builder --win"
  },
  "dependencies": {
    "@vrm/app-core": "workspace:*",
    "@vrm/platform-contracts": "workspace:*",
    "@vrm/shared": "workspace:*",
    "@vrm/ui": "workspace:*",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.vrmmotiongeneration.desktop",
    "productName": "VRMMotionGeneration",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    }
  }
}
