stateDiagram-v2
    [*] --> Unloaded

    state Unloaded {
        [*] --> LoadingDefaultRig
        LoadingDefaultRig --> ProceduralMannequinReady
    }

    Unloaded --> AvatarReady : VRM File Uploaded / Procedural Initialized

    state AvatarReady {
        [*] --> InspectingBones
        InspectingBones --> BonesMapped : Check All Standard Humanoid Bones
        BonesMapped --> IdlePose
    }

    AvatarReady --> ModeA_FixturePlaying : Load Mode A Fixture
    AvatarReady --> ModeB_Connecting : Request Real Inference

    state ModeA_FixturePlaying {
        [*] --> PlayingCycle
        PlayingCycle --> Paused : Click Pause
        Paused --> PlayingCycle : Click Play
        PlayingCycle --> Seeking : Drag Scrubber
        Seeking --> PlayingCycle : Release Scrubber
    }

    state ModeB_Connecting {
        [*] --> CheckingCheckpoints
        CheckingCheckpoints --> CheckpointsMissing : Weights are LFS Pointers
        CheckingCheckpoints --> ModelLoaded : Weights Verified
        CheckpointsMissing --> ErrorState : Display Guidance Toast (HTTP 503)
        ModelLoaded --> StreamingMotion : WS /ws/motion Active
    }

    ErrorState --> AvatarReady : Acknowledge Error / Fallback
    ModeB_Connecting --> ModeA_FixturePlaying : Fallback to Fixture
    ModeA_FixturePlaying --> AvatarReady : Reset / New Avatar Uploaded
