# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.so

# Environments & virtualenvs
.env
.env.*
!.env.example
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Node.js & Web build artifacts
node_modules/
dist/
build/
.vite/
.npm/

# Testing & Cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache/

# Local databases
*.sqlite
*.sqlite3
*.db
*.db-journal

# Checkpoints, model weights, and heavy binary assets
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
*.bin

# Standalone experiment outputs (keep README placeholders tracked)
exp/checkpoints/*
!exp/checkpoints/README.md
exp/datasets/*
!exp/datasets/README.md
exp/artifacts/*
!exp/artifacts/README.md

# Archives, bundles, and backup directories
*.bundle
*.patch
*.tar.gz
*.zip
*_backup*/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
